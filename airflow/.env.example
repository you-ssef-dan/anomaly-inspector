# Airflow's settings: copy to .env (ignored by git) and fill in. docker-compose.yaml passes each
# value only to the containers that need it.

# id -u: the files Airflow writes belong to you, not root
AIRFLOW_UID=1000
# getent group docker: lets the scheduler use the Docker socket
DOCKER_GID=968
# Absolute path (no ~): mounted at the same path inside Airflow and in the training containers
INSPECTION_WORKSPACE=/home/you/airflow-workspace

# Random secrets. Fernet key (encrypts connection passwords in Airflow's database):
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# JWT secret (signs Airflow's API tokens):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# Fine-grained GitHub token, this repository only, Contents and Pull requests read and write:
# the retraining DAG pushes a branch and opens a pull request with it. Only the scheduler gets it.
GH_TOKEN=

# The DagsHub token is not here: make airflow-up takes it from ../.dvc/config.local, so it has one
# copy on this laptop. To replace it everywhere: scripts/rotate_dagshub_token.sh
