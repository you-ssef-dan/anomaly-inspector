# Copy to .env (git-ignored) and set a real password: cp .env.example .env
POSTGRES_PASSWORD=change-me
# Where the code sends runs. Training scripts read this and never hard-code a server.
MLFLOW_TRACKING_URI=http://localhost:5000
# Optional: the password of Grafana's admin account, used to edit dashboards (admin when empty)
GRAFANA_ADMIN_PASSWORD=
